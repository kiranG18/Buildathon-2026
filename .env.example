# Required in production. Dev defaults live in backend/core/config.py.
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
JWT_SECRET=change-me-32-random-bytes
WEBHOOK_SHARED_SECRET=change-me-32-random-bytes
MCP_TOKEN=change-me-32-random-bytes
CORS_ORIGINS=http://localhost:8000

# LLM. LLM_MODE: fake (offline templates), record, replay, live.
LLM_MODE=fake
# LLM_PROVIDER: groq (default), anthropic or gemini. Set the matching key. Models default per provider and can be overridden.
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# Second provider after two failed attempts: openai or groq.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=
EMBEDDINGS_API_KEY=
# Real prospect discovery (Apollo.io). Without it, discover() falls back to the seeded demo pool.
APOLLO_API_KEY=
# Real email lookup for a named person at a known domain (Hunter.io). Without it, a discovered
# LinkedIn employee gets a sandbox placeholder address instead of a real one.
HUNTER_API_KEY=

# DronaHQ agents. AGENT_PROVIDER_*: dronahq or direct.
DRONAHQ_RESEARCHER_WEBHOOK_URL=
DRONAHQ_RESPONDER_WEBHOOK_URL=
DRONAHQ_API_KEY=
DRONAHQ_VOICE_AGENT_ID=
DRONAHQ_VOICE_FROM_NUMBER=
AGENT_PROVIDER_RESEARCHER=direct
AGENT_PROVIDER_RESPONDER=direct
AGENT_PROVIDER_CALLER=direct

# Channels. Modes: live or sandbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
SEED_INBOX_BASE=helix.sandbox@gmail.com
SMTP_HOST=
SMTP_USER=
SMTP_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CHANNEL_MODE_EMAIL=sandbox
CHANNEL_MODE_SMS=sandbox
CHANNEL_MODE_LINKEDIN=sandbox
CHANNEL_MODE_VOICE=sandbox
ALLOWED_RECIPIENTS=gmail.com

# Worker tuning
WORKER_CAMPAIGN_ID=
FAKE_LATENCY_MS=400

# Calendly. CALENDLY_MODE: off (deterministic fake slots) or live (real availability + real bookings via webhook).
CALENDLY_MODE=off
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Google Sheets CRM mirror. See MANUAL_ACTIONS.md MA-15 for setup.
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
SHEETS_SHEET_NAME=CRM
SHEETS_SERVICE_ACCOUNT_JSON=
SHEETS_SYNC_SECONDS=120
