# Required in production. Dev defaults live in backend/core/config.py.
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
JWT_SECRET=change-me-32-random-bytes
WEBHOOK_SHARED_SECRET=change-me-32-random-bytes
MCP_TOKEN=change-me-32-random-bytes
CORS_ORIGINS=http://localhost:8000

# LLM. LLM_MODE: fake (offline templates), record, replay, live.
LLM_MODE=fake
# LLM_PROVIDER: anthropic (default), gemini or groq. Set the matching key. Models default per provider and can be overridden.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# Second provider after two failed attempts: openai or groq.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=
EMBEDDINGS_API_KEY=

# DronaHQ agents. AGENT_PROVIDER_*: dronahq or direct.
DRONAHQ_RESEARCHER_WEBHOOK_URL=
DRONAHQ_RESPONDER_WEBHOOK_URL=
DRONAHQ_API_KEY=
DRONAHQ_VOICE_AGENT_ID=
DRONAHQ_VOICE_FROM_NUMBER=
AGENT_PROVIDER_RESEARCHER=direct
AGENT_PROVIDER_RESPONDER=direct
AGENT_PROVIDER_CALLER=direct

# Channels. Modes: live or sandbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
SEED_INBOX_BASE=helix.sandbox@gmail.com
SMTP_HOST=
SMTP_USER=
SMTP_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CHANNEL_MODE_EMAIL=sandbox
CHANNEL_MODE_SMS=sandbox
CHANNEL_MODE_LINKEDIN=sandbox
CHANNEL_MODE_VOICE=sandbox
ALLOWED_RECIPIENTS=gmail.com

# Worker tuning
WORKER_CAMPAIGN_ID=
FAKE_LATENCY_MS=400
